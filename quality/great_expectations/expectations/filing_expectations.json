{
  "expectation_suite_name": "raw_financial_facts_suite",
  "meta": {
    "table": "bronze.raw_financial_facts",
    "notes": "Statistical expectations. Run by quality/run_expectations.py. 'mostly' allows a small share of exceptions, because real SEC data has some (e.g. rare form types)."
  },
  "expectations": [
    {"expectation_type": "expect_table_row_count_to_be_between", "kwargs": {"min_value": 100}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "cik"}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "metric"}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "period_end"}},
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "value", "mostly": 0.99}},
    {"expectation_type": "expect_column_values_to_match_regex", "kwargs": {"column": "cik", "regex": "^[0-9]{10}$"}},
    {"expectation_type": "expect_column_values_to_be_in_set",
     "kwargs": {"column": "form", "value_set": ["10-K", "10-Q", "10-K/A", "10-Q/A", "8-K", "10-KT", "20-F", "S-1", "S-4"], "mostly": 0.98}},
    {"expectation_type": "expect_column_values_to_be_unique", "kwargs": {"column": "fact_key"}},
    {"expectation_type": "expect_column_pair_values_A_to_be_greater_than_B",
     "kwargs": {"column_A": "period_end", "column_B": "period_start", "or_equal": false, "ignore_row_if": "either_value_is_missing"}},
    {"expectation_type": "expect_column_proportion_of_unique_values_to_be_between",
     "kwargs": {"column": "accession_number", "max_value": 0.5}}
  ]
}
